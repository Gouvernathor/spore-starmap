{
  "name": "starmap",
  "version": "1.0.0",
  "description": "An interactive map of the Spore galaxy",
  "main": "app.js",
  "type": "module",
  "dependencies": {
    "@three-ts/orbit-controls": "^1.4.7",
    "express": "^4.18.2",
    "jspanel4": "^4.16.1",
    "qfs-compression": "^0.2.1",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/three": "^0.174.0",
    "nodemon": "^3.0.3",
    "tsup": "^8.4.0",
    "typescript": "*"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "build": "pkg -c package.json app.js"
  },
  "keywords": [
    "spore",
    "galaxy",
    "editor",
    "interactive",
    "data",
    "visualizaion"
  ],
  "author": "TheOnlyZac",
  "license": "GPL-3.0",
  "pkg": {
    "scripts": [
      "backend/src/**/*"
    ],
    "assets": [
      "public/**/*",
      "backent/bin/**/*"
    ],
    "targets": [
      "node12-win-x64",
      "node12-macos-x64",
      "node12-linux-x64"
    ],
    "outputPath": "build"
  }
}
